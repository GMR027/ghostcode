#!/bin/sh
# Configura GhostCode para el usuario actual: extensión (en VS Code y/o VSCodium), Ollama y modelo.
# Opciones: ghostcode-setup --help
if [ "$(id -u)" = 0 ]; then
  echo "Ejecuta ghostcode-setup con tu usuario, sin sudo (los editores instalan las extensiones por usuario)." >&2
  exit 1
fi
exec /usr/share/ghostcode/install.sh --vsix /usr/share/ghostcode/ghostcode.vsix "$@"
